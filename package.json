{
  "name": "ball-simulator",
  "version": "1.0.0",
  "description": "Prompt-driven bouncing ball simulator. Agents turn a user prompt into a scene JSON, this renders a vertical MP4 with note-on-bounce audio.",
  "private": true,
  "type": "module",
  "scripts": {
    "make": "tsx src/cli/make.ts",
    "validate": "tsx src/cli/validate.ts",
    "modes": "tsx src/cli/modes.ts",
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden": "tsx scripts/update-golden.mts",
    "parity": "tsx scripts/parity.mts",
    "docs:assets": "node scripts/readme-assets.mjs",
    "probe:trig": "tsx scripts/trig-probe.mts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  }
}
